{
  "name": "news_flash",
  "description": "High-urgency news broadcast layout with bold headlines and crisp transitions",
  "aspect_ratio": "16:9",
  "fps": 30,
  "visual": {
    "ken_burns_enabled": false,
    "default_transition": "cut",
    "transition_duration": 0.0,
    "color_grading_preset": "news_broadcast"
  },
  "audio": {
    "target_lufs": -14.0,
    "true_peak": -1.0,
    "music_volume": 0.18,
    "music_ducking_reduction_db": -14.0,
    "music_ducking_threshold_db": -20.0
  },
  "caption": {
    "font_name": "Noto Sans Bengali",
    "font_size": 56,
    "primary_color": "&H0000FFFF",
    "outline_color": "&H00000000",
    "back_color": "&H80000000",
    "bold": true,
    "outline_width": 4,
    "shadow_depth": 2,
    "alignment": 2,
    "margin_v": 60,
    "highlight_active_word": false
  }
}
