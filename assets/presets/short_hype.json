{
  "name": "short_hype",
  "description": "Fast-paced TikTok / Reels / Shorts 9:16 layout with punchy word karaoke captions and whoosh SFX",
  "aspect_ratio": "9:16",
  "fps": 30,
  "visual": {
    "ken_burns_enabled": true,
    "default_transition": "cut",
    "transition_duration": 0.2,
    "color_grading_preset": "vibrant_contrast"
  },
  "audio": {
    "target_lufs": -14.0,
    "true_peak": -1.0,
    "music_volume": 0.20,
    "music_ducking_reduction_db": -10.0,
    "music_ducking_threshold_db": -22.0
  },
  "caption": {
    "font_name": "Noto Sans Bengali",
    "font_size": 52,
    "primary_color": "&H00FFFFFF",
    "outline_color": "&H00000000",
    "back_color": "&H80000000",
    "bold": true,
    "outline_width": 4,
    "shadow_depth": 2,
    "alignment": 2,
    "margin_v": 240,
    "highlight_active_word": true
  }
}
