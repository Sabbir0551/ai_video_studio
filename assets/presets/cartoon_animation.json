{
  "name": "cartoon_animation",
  "description": "Pixar/Disney 3D animation style for cartoon stories, kids and toddlers with warm colors and soft music ducking",
  "aspect_ratio": "16:9",
  "fps": 30,
  "visual": {
    "ken_burns_enabled": true,
    "default_transition": "dissolve",
    "transition_duration": 0.6,
    "color_grading_preset": "vibrant_warm"
  },
  "audio": {
    "target_lufs": -14.0,
    "true_peak": -1.0,
    "music_volume": 0.18,
    "music_ducking_reduction_db": -15.0,
    "music_ducking_threshold_db": -22.0
  },
  "caption": {
    "font_name": "Noto Sans Bengali",
    "font_size": 56,
    "primary_color": "&H0024E5FF",
    "outline_color": "&H00101020",
    "back_color": "&H60000000",
    "bold": true,
    "outline_width": 4,
    "shadow_depth": 2,
    "alignment": 2,
    "margin_v": 60,
    "highlight_active_word": true
  }
}
