{
  "name": "clean_corporate",
  "description": "Polished, balanced 16:9 explainer style for presentations and professional lessons",
  "aspect_ratio": "16:9",
  "fps": 30,
  "visual": {
    "ken_burns_enabled": true,
    "default_transition": "dissolve",
