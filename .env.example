# Environment Configuration for AI Video Studio

# Application Settings
STUDIO_ENV=development
STUDIO_PORT=8000
STUDIO_HOST=0.0.0.0
STUDIO_DATA_DIR=data
STUDIO_LOG_LEVEL=INFO

# Database & Queue
DATABASE_URL=sqlite:///data/studio.db
REDIS_URL=redis://localhost:6379/0
USE_IN_PROCESS_QUEUE=true

# Audio & Video Targets
DEFAULT_LUFS_TARGET=-14.0
DEFAULT_TRUE_PEAK_TARGET=-1.0
DEFAULT_VIDEO_FPS=30
DEFAULT_RESOLUTION=1920x1080

# Bangla & Typography
BANGLA_DEFAULT_FONT=Noto Sans Bengali
DEFAULT_FONT_PATH=assets/fonts/NotoSansBengali-VariableFont.ttf

# AI & LLM Providers (Optional paid keys, leave empty to use local/mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Voice / TTS Providers
DEFAULT_TTS_PROVIDER=edge-tts
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Stock Media
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Budgets & Limits
JOB_MAX_BUDGET_USD=5.00
MONTHLY_MAX_BUDGET_USD=50.00
